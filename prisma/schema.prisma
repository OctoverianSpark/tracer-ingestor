generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

model computers {
  id             BigInt           @id @default(autoincrement())
  serial_number  String?          @unique @db.VarChar(255)
  hostname       String           @unique @db.VarChar(255)
  username       String?          @db.VarChar(255)
  ip_address     String?          @db.VarChar(50)
  machineBrand   String?          @db.VarChar(255)
  machineModel   String?          @db.VarChar(255)
  last_seen      DateTime?        @default(now()) @db.DateTime(0)
  created_at     DateTime?        @default(now()) @db.DateTime(0)
  updated_at     DateTime?        @updatedAt @db.DateTime(0)
  appuser_id     BigInt?
  app_usage_logs app_usage_logs[]
  appuser        appuser?         @relation(fields: [appuser_id], references: [id], onDelete: SetNull)
  state_logs     state_logs[]

  @@index([hostname])
  @@index([appuser_id])
}

model roles {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  access_level Json
  appuser      appuser[]
}

model appuser {
  id         BigInt      @id @default(autoincrement())
  full_name  String      @db.Text
  email      String      @unique
  role_id    Int?
  role       roles?      @relation(fields: [role_id], references: [id], onDelete: SetNull)
  created_at DateTime?   @default(now()) @db.DateTime(0)
  updated_at DateTime?   @updatedAt @db.DateTime(0)
  computers  computers[]
  schedules  schedules[]
  group_id   Int?
  group      groups?     @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@index([group_id])
  @@index([role_id])
}

model groups {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  appuser appuser[]
}

model state_logs {
  id          BigInt             @id @default(autoincrement())
  computer_id BigInt?
  user_name   String?            @db.VarChar(100)
  state       state_log_state
  category    state_log_category
  type        state_log_type
  timestamp   DateTime           @db.DateTime(0)
  reason      String?            @db.VarChar(255)
  computer    computers?         @relation(fields: [computer_id], references: [id], onDelete: SetNull)

  @@index([computer_id])
  @@index([timestamp])
  @@index([computer_id, timestamp])
  @@index([state])
  @@index([category])
}

model app_usage_logs {
  id             BigInt     @id @default(autoincrement())
  computer_id    BigInt?
  interval_start DateTime   @db.DateTime(0)
  interval_end   DateTime   @db.DateTime(0)
  apps           Json
  computer       computers? @relation(fields: [computer_id], references: [id], onDelete: SetNull)

  @@index([computer_id])
  @@index([interval_start])
  @@index([computer_id, interval_start])
}

model programation {
  id          BigInt      @id @default(autoincrement())
  name        String      @unique @db.VarChar(255)
  start_day   String
  start_lunch String
  end_lunch   String
  end_day     String
  schedules   schedules[]
}

model schedules {
  id              BigInt       @id @default(autoincrement())
  appuser_id      BigInt?
  programation_id BigInt
  day_of_week     String       @db.VarChar(20)
  appuser         appuser?     @relation(fields: [appuser_id], references: [id], onDelete: Cascade)
  programation    programation @relation(fields: [programation_id], references: [id], onDelete: Cascade)

  @@index([appuser_id])
  @@index([programation_id])
}

model categorization_apps {
  id       BigInt   @id @default(autoincrement())
  name     String   @db.VarChar(255)
  category category
}

enum category {
  productive
  unproductive
  ignore
}

enum state_log_state {
  working
  break
  wc
  lunch
  idle
  offline
}

enum state_log_category {
  active
  neutral
  inactive
}

enum state_log_type {
  auto
  manual
}

enum users_role {
  admin
  manager
  user
}
