generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

model computers {
  id             BigInt           @id @default(autoincrement())
  serial_number  String?          @unique @db.VarChar(255)
  hostname       String           @unique @db.VarChar(255)
  username       String?          @db.VarChar(255)
  ip_address     String?          @db.VarChar(50)
  machineBrand   String?          @db.VarChar(255)
  machineModel   String?          @db.VarChar(255)
  take_screenshots Boolean        @default(true)
  last_seen      DateTime?        @default(now()) @db.DateTime(0)
  created_at     DateTime?        @default(now()) @db.DateTime(0)
  updated_at     DateTime?        @updatedAt @db.DateTime(0)
  appuser_id     BigInt?
  app_usage_logs app_usage_logs[]
  appuser        appuser?         @relation(fields: [appuser_id], references: [id], onDelete: SetNull)
  state_logs     state_logs[]
  reports        reports[]

  @@index([hostname])
  @@index([appuser_id])
}

model roles {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  access_level Json
  appuser      appuser[]
}

model appuser {
  id           BigInt      @id @default(autoincrement())
  full_name    String      @db.Text
  email        String      @unique
  role_id      Int?
  role         roles?      @relation(fields: [role_id], references: [id], onDelete: SetNull)
  created_at   DateTime?   @default(now()) @db.DateTime(0)
  updated_at   DateTime?   @updatedAt @db.DateTime(0)
  absence_status user_absence_status?
  computers    computers[]
  schedules    schedules[]
  group_id     Int?
  group        groups?     @relation(fields: [group_id], references: [id], onDelete: SetNull)
  rotation_cycle rotation_cycles?
  reports      reports[]

  @@index([group_id])
  @@index([role_id])
}

model groups {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  block_own_reports Boolean @default(false)
  agent_preferences Json?

  appuser              appuser[]
  can_view             group_visibility[]        @relation("GroupViewers")
  viewed_by            group_visibility[]        @relation("GroupVisible")
  report_type_assigned report_type_assignments[]
  state_categories     state_categories[]
  states               states[]
  hidden_states        group_state_visibility[]
}

// Catálogo único y global (ver `states`/`state_categories`) — esto NO es un catálogo por grupo.
// Una fila acá significa "este code está OCULTO del menú del agente para este grupo". Ausencia de
// fila = visible (hereda el catálogo global). No hay columna booleana a propósito: la mayoría de
// grupos no ocultan nada o solo un par de codes, así que "fila = excepción" evita 7 filas con un
// booleano por grupo para el caso común.
model group_state_visibility {
  id       Int    @id @default(autoincrement())
  group_id Int
  code     Int
  group    groups @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, code])
}

model group_visibility {
  viewer_group_id  Int
  visible_group_id Int
  viewer_group     groups @relation("GroupViewers", fields: [viewer_group_id], references: [id], onDelete: Cascade)
  visible_group    groups @relation("GroupVisible", fields: [visible_group_id], references: [id], onDelete: Cascade)

  @@id([viewer_group_id, visible_group_id])
  @@index([visible_group_id])
}

model state_logs {
  id          BigInt            @id @default(autoincrement())
  computer_id BigInt?
  user_name   String?           @db.VarChar(100)
  code        Int
  state_id    Int?
  category_id Int?
  type        state_log_type
  timestamp   DateTime          @db.DateTime(0)
  reason      String?           @db.VarChar(255)
  computer    computers?        @relation(fields: [computer_id], references: [id], onDelete: SetNull)
  state       states?           @relation(fields: [state_id], references: [id], onDelete: SetNull)
  category    state_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([computer_id])
  @@index([timestamp])
  @@index([computer_id, timestamp])
  @@index([state_id])
  @@index([category_id])
}

model state_categories {
  id         Int     @id @default(autoincrement())
  group_id   Int?
  group      groups? @relation(fields: [group_id], references: [id], onDelete: Cascade)
  key        String  @db.VarChar(50)
  name       String  @db.VarChar(100)
  color      String? @db.VarChar(20)
  sort_order Int     @default(0)

  states     states[]
  state_logs state_logs[]

  @@index([group_id])
}

model states {
  id          Int              @id @default(autoincrement())
  group_id    Int?
  group       groups?          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  code        Int
  name        String            @db.VarChar(100)
  category_id Int?
  category    state_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  sort_order  Int               @default(0)

  state_logs  state_logs[]

  @@index([group_id])
  @@index([category_id])
}

model app_usage_logs {
  id             BigInt     @id @default(autoincrement())
  computer_id    BigInt?
  interval_start DateTime   @db.DateTime(0)
  interval_end   DateTime   @db.DateTime(0)
  apps           Json
  active_seconds Int        @default(0)
  idle_seconds   Int        @default(0)
  mouse_clicks   Int        @default(0)
  keystrokes     Int        @default(0)
  computer       computers? @relation(fields: [computer_id], references: [id], onDelete: SetNull)

  @@index([computer_id])
  @@index([interval_start])
  @@index([computer_id, interval_start])
}

model programation {
  id             BigInt           @id @default(autoincrement())
  name           String           @unique @db.VarChar(255)
  start_day      String
  start_lunch    String
  end_lunch      String
  end_day        String
  schedules      schedules[]
  rotation_slots rotation_slots[]
}

model schedules {
  id              BigInt       @id @default(autoincrement())
  appuser_id      BigInt?
  programation_id BigInt
  day_of_week     String       @db.VarChar(20)
  appuser         appuser?     @relation(fields: [appuser_id], references: [id], onDelete: Cascade)
  programation    programation @relation(fields: [programation_id], references: [id], onDelete: Cascade)

  @@unique([appuser_id, day_of_week])
  @@index([programation_id])
}

model rotation_cycles {
  id         BigInt   @id @default(autoincrement())
  appuser_id BigInt   @unique
  name       String   @db.VarChar(255)
  start_date DateTime @db.Date
  weeks      Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)
  appuser    appuser          @relation(fields: [appuser_id], references: [id], onDelete: Cascade)
  slots      rotation_slots[]
}

model rotation_slots {
  id                BigInt          @id @default(autoincrement())
  rotation_cycle_id BigInt
  week_index        Int
  day_of_week       String          @db.VarChar(20)
  programation_id   BigInt
  rotation_cycle    rotation_cycles @relation(fields: [rotation_cycle_id], references: [id], onDelete: Cascade)
  programation      programation    @relation(fields: [programation_id], references: [id], onDelete: Cascade)

  @@unique([rotation_cycle_id, week_index, day_of_week])
  @@index([programation_id])
}

model report_types {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @updatedAt @db.DateTime(0)

  assignments report_type_assignments[]
  reports     reports[]
}

model report_type_assignments {
  id             Int          @id @default(autoincrement())
  report_type_id Int
  group_id       Int
  report_type    report_types @relation(fields: [report_type_id], references: [id], onDelete: Cascade)
  group          groups       @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([report_type_id, group_id])
  @@index([group_id])
}

model reports {
  id             BigInt       @id @default(autoincrement())
  report_type_id Int
  computer_id    BigInt?
  appuser_id     BigInt?
  message        String       @db.Text
  created_at     DateTime?    @default(now()) @db.DateTime(0)

  report_type    report_types @relation(fields: [report_type_id], references: [id], onDelete: Cascade)
  computer       computers?   @relation(fields: [computer_id], references: [id], onDelete: SetNull)
  appuser        appuser?     @relation(fields: [appuser_id], references: [id], onDelete: SetNull)

  @@index([report_type_id])
  @@index([computer_id])
  @@index([appuser_id])
}

model categorization_apps {
  id       BigInt   @id @default(autoincrement())
  name     String   @db.VarChar(255)
  category category
}

enum category {
  productive
  unproductive
  ignore
}

enum state_log_type {
  auto
  manual
}

enum users_role {
  admin
  manager
  user
}

enum user_absence_status {
  VACACIONES
  INACTIVIDAD
  AUSENCIA_MEDICA
  PERMISO
}
