generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

model computers {
  id             BigInt           @id @default(autoincrement())
  serial_number  String?          @unique @db.VarChar(255)
  hostname       String           @unique @db.VarChar(255)
  ip_address     String?          @db.VarChar(50)
  last_seen      DateTime?        @default(now()) @db.DateTime(0)
  created_at     DateTime?        @default(now()) @db.DateTime(0)
  updated_at     DateTime?        @updatedAt @db.DateTime(0) // ← added
  state_logs     state_logs[]
  app_usage_logs app_usage_logs[]

  personal_id BigInt? // ← BigInt for consistency
  personal    personal? @relation(fields: [personal_id], references: [id])

  @@index([hostname])
  @@index([personal_id])
}

model users {
  id            BigInt     @id @default(autoincrement())
  username      String     @unique @db.VarChar(100)
  email         String?    @unique @db.VarChar(255)
  password_hash String     @db.Text
  role          users_role @default(user)
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  updated_at    DateTime?  @updatedAt @db.DateTime(0) // ← added
}

model personal {
  id                BigInt         @id @default(autoincrement()) // ← BigInt for consistency
  first_name        String         @db.Text
  middle_name       String?        @db.Text
  last_name         String         @db.Text
  doc_type          Int
  document          String?        @unique @db.VarChar(150)
  job_title         String?        @db.VarChar(120)
  document_type     document_types @relation(fields: [doc_type], references: [id])
  corporative_email String         @default("")
  mode_type         Int
  created_at        DateTime?      @default(now()) @db.DateTime(0) // ← added
  updated_at        DateTime?      @updatedAt @db.DateTime(0) // ← added
  time_mesh         time_mesh[]
  computers         computers[]
  mode              modes          @relation(fields: [mode_type], references: [id])

  @@index([doc_type, mode_type])
}

model modes {
  id       Int        @id @default(autoincrement())
  name     String     @db.Text
  personal personal[]
}

model document_types {
  id         Int        @id @default(autoincrement())
  full_name  String     @db.VarChar(120)
  short_name String     @db.VarChar(60)
  value      String?    @db.VarChar(120)
  active     Int?       @db.TinyInt
  personal   personal[]
}

model time_mesh {
  id          BigInt    @id @default(autoincrement()) // ← BigInt for consistency
  user_id     BigInt // ← BigInt to match personal.id
  day_of_week Int       @db.TinyInt // ← ADDED: 0=Sun … 6=Sat
  start       DateTime  @db.Time(0)
  end         DateTime  @db.Time(0)
  break       DateTime  @db.Time(0)
  lunch       DateTime  @db.Time(0)
  overtime    DateTime? @db.Time(0)
  personal    personal  @relation(fields: [user_id], references: [id])

  @@unique([user_id, day_of_week]) // ← one schedule per person per day
  @@index([user_id])
}

model state_logs {
  id          BigInt             @id @default(autoincrement())
  computer_id BigInt
  user_name   String?            @db.VarChar(100)
  state       state_log_state
  category    state_log_category
  type        state_log_type
  timestamp   DateTime           @db.DateTime(0)
  reason      String?            @db.VarChar(255)
  computer    computers          @relation(fields: [computer_id], references: [id])

  @@index([computer_id])
  @@index([timestamp])
  @@index([computer_id, timestamp])
  @@index([state])
  @@index([category])
}

model app_usage_logs {
  id             BigInt    @id @default(autoincrement())
  computer_id    BigInt
  interval_start DateTime  @db.DateTime(0)
  interval_end   DateTime  @db.DateTime(0)
  // Json is flexible but not filterable at DB level.
  // If you need to query by app name later, consider a separate app_usage_entries table.
  apps           Json
  computer       computers @relation(fields: [computer_id], references: [id])

  @@index([computer_id])
  @@index([interval_start])
  @@index([computer_id, interval_start])
}

enum state_log_state {
  working
  break
  wc
  lunch
  idle
  offline
}

enum state_log_category {
  active
  neutral
  inactive
}

enum state_log_type {
  auto
  manual
}

enum users_role {
  admin
  manager
  user
}
